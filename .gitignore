# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Logs
*.log
logs/

# Databases / local data
*.sqlite3
*.db

# Backup / temp files
*.bak
*.tmp
*~

# Project-specific
temp/
gcode/temp
docs/_build
# autosummary_generate = True (docs/conf.py) regenerates these stubs on
# every `sphinx-build` from the live package tree -- checking them in is
# exactly the mechanism that let docs/api.rst go stale before (see #21).
docs/generated/

# cmd2 writes the interactive shell's history next to the shell module
# (DefaultPaths.DIR_SHELL). It's a per-developer runtime artifact, and cmd2
# stores it XZ-compressed, so tracking it produced an unreviewable binary
# diff on every session. Unanchored so it stays ignored if DIR_SHELL moves.
.tap_history
flycheck_*.py

# Environment / local config
.env
.env.*
.envrc
.dir-locals.el

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code (local session state, permissions, scheduled-task locks --
# never repo config; that lives in .claude/CLAUDE.md-adjacent tracked files
# like CLAUDE.md itself, not under this directory)
.claude/

# Emacs
.#*
\#*\#
auto-save-list/

# OS
.DS_Store
Thumbs.db
Desktop.ini
