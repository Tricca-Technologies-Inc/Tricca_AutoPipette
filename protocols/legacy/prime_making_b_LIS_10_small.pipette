# A protocol for making prime panel B LIS 10mL, for the componentsrequiring the smaller pipette tips

# Sodium 3-hydroxybutyrate-3,4,4,4-d4
pipette 30.0 --extra_air --after_air --src_row 0 --src_col 0 manu2 KIT1 --dispense_vol 30.0 --tipbox tipbox --prewet 1 

# 1-13C-alpha-Ketoglutaric acid
pipette 30.0 --extra_air --after_air --src_row 1 --src_col 0 manu2 KIT1 --dispense_vol 30.0 --tipbox tipbox --prewet 1 

# Citric acid-2,2,4,4-d4
pipette 50.0 --extra_air --after_air --src_row 2 --src_col 0 manu2 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 --keep_tip
pipette 50.0 --extra_air --after_air --src_row 2 --src_col 0 manu2 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 

# Butyric acid-1-13C
pipette 20.0 --extra_air --after_air --src_row 3 --src_col 0 manu2 KIT1 --dispense_vol 20.0 --tipbox tipbox --prewet 1 

# Propionic acid-1-13C
pipette 20.0 --extra_air --after_air --src_row 0 --src_col 0 manu1 KIT1 --dispense_vol 20.0 --tipbox tipbox --prewet 1 

# HPHPA-13C
pipette 20.0 --extra_air --after_air --src_row 1 --src_col 0 manu1 KIT1 --dispense_vol 20.0 --tipbox tipbox --prewet 1 

# Succinic acid-d4
pipette 20.0 --extra_air --after_air --src_row 2 --src_col 0 manu1 KIT1 --dispense_vol 20.0 --tipbox tipbox --prewet 1 

# 13C2-d2-Fumaric acid
pipette 20.0 --extra_air --after_air --src_row 3 --src_col 0 manu1 KIT1 --dispense_vol 20.0 --tipbox tipbox --prewet 1 

# Pyruvic acid-13C
pipette 20.0 --extra_air --after_air --src_row 0 --src_col 1 manu2 KIT1 --dispense_vol 20.0 --tipbox tipbox --prewet 1 

# Hippurate-d2
pipette 10.0 --extra_air --after_air --src_row 1 --src_col 1 manu2 KIT1 --dispense_vol 10.0 --tipbox tipbox --prewet 1 

# Methyl-d3-Malonic acid
pipette 10.0 --extra_air --after_air --src_row 2 --src_col 1 manu2 KIT1 --dispense_vol 10.0 --tipbox tipbox --prewet 1 

# Indole-3-acetic-2,2-d2
pipette 20.0 --extra_air --after_air --src_row 3 --src_col 1 manu2 KIT1 --dispense_vol 20.0 --tipbox tipbox --prewet 1 

# 1,3-15N2-Uric acid
pipette 50.0 --extra_air --after_air --src_row 0 --src_col 1 manu1 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 --keep_tip
pipette 50.0 --extra_air --after_air --src_row 0 --src_col 1 manu1 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 --keep_tip
pipette 50.0 --extra_air --after_air --src_row 0 --src_col 1 manu1 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 --keep_tip 
pipette 50.0 --extra_air --after_air --src_row 0 --src_col 1 manu1 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 
