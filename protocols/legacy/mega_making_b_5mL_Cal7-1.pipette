#first of four parts of making cal 7 for Mega Panel B. One rack at a time to reduce evaporation

# 2-Hydroxy-2-methylbutyric acid 25uL
pipette 25 --extra_air --after_air --src_row 0 --src_col 0 manu2 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 2-Hydroxy-3-methylvaleric acid 25uL
pipette 25 --extra_air --after_air --src_row 1 --src_col 0 manu2 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 2-Hydroxybutyric acid 25uL
pipette 25 --extra_air --after_air --src_row 2 --src_col 0 manu2 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 2-hydroxyglutaric acid 25uL
pipette 25 --extra_air --after_air --src_row 3 --src_col 0 manu2 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 2-Hydroxyisobutyric acid 25uL
pipette 25 --extra_air --after_air --src_row 0 --src_col 0 manu1 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 2-Hydroxyisovaleric acid 25uL
pipette 25 --extra_air --after_air --src_row 1 --src_col 0 manu1 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 2-Hydroxyphenylacetic acid 25uL
