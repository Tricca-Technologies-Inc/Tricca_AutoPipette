# 3-Aminoisobutyric acid 25uL
pipette 25 --extra_air --after_air --src_row 3 --src_col 1 manu2 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# CMPF 25uL
pipette 25 --extra_air --after_air --src_row 0 --src_col 1 manu1 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 3-Deoxyglucosone 25uL
pipette 25 --extra_air --after_air --src_row 1 --src_col 1 manu1 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 3-Hydroxybutyric acid 25uL
