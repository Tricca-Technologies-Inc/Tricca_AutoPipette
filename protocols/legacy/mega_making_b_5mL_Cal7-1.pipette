# 3-Hydroxyisovaleric acid 25uL
pipette 25 --extra_air --after_air --src_row 0 --src_col 2 manu2 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 3-Hydroxyphenylacetic acid 25uL
pipette 25 --extra_air --after_air --src_row 1 --src_col 2 manu2 KIT1 --dispense_vol 25 --tipbox tipbox --prewet 1
# 3-Indoleacetic acid 25uL
