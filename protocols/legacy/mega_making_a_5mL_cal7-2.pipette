# Protocol for the second part of making cal 7 5mL for Mega Panel A


# L-Glutamine 100uL
pipette 50 --extra_air --after_air --src_row 0 --src_col 0 manu2 KIT1 --dispense_vol 50 --tipbox tipbox --prewet 1 --keep_tip
pipette 50 --extra_air --after_air --src_row 0 --src_col 0 manu2 KIT1 --dispense_vol 50 --tipbox tipbox --prewet 1

