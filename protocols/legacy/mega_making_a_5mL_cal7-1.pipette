# 3-Nitrotyrosine 100uL
pipette 50 --extra_air --after_air --src_row 1 --src_col 0 manu1 KIT1 --dispense_vol 50 --tipbox tipbox --prewet 1 --keep_tip
pipette 50 --extra_air --after_air --src_row 1 --src_col 0 manu1 KIT1 --dispense_vol 50 --tipbox tipbox --prewet 1
