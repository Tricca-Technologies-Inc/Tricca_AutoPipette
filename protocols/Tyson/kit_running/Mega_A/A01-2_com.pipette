# protocol for adding in FIS1 and FIS2 for panel A if they are combined into two screw cap vials

select_setup Tyson100_system.json
init
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.


pipette 20.0 --tip_end keep --dest_row 1 --dest_col 0 FIS1 96wellplate --tipbox tipbox --prewet 5
pipette 20.0 --tip_end keep --dest_row 2 --dest_col 0 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 3 --dest_col 0 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 4 --dest_col 0 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 5 --dest_col 0 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 6 --dest_col 0 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 7 --dest_col 0 FIS1 96wellplate --tipbox tipbox

pipette 20.0 --tip_end keep --dest_row 0 --dest_col 1 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 1 --dest_col 1 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 2 --dest_col 1 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 3 --dest_col 1 FIS1 96wellplate --tipbox tipbox
pipette 20.0 --tip_end keep --dest_row 4 --dest_col 1 FIS1 96wellplate --tipbox tipbox
