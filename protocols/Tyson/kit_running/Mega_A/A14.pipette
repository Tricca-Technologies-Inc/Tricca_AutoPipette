# MEGA Panel A — combined A14: aspirate 60uL from COLPLATE per well,
# split 50uL to LCPLATE and 10uL to DFIPLATE.
# Replaces separate A14_50.pipette and A14_10.pipette — saves 96 tips.
# Each well of COLPLATE is visited once; src_row/src_col advance in sync
# with both destination plates via their natural sequential order.

load_pipette TysonP100.json
home

pipette 60.0 --src_row 0 --src_col 0  COLPLATE LCPLATE --prewet 1 --splits 'LCPLATE:50;DFIPLATE:10'
pipette 60.0 --src_row 0 --src_col 1  COLPLATE LCPLATE --prewet 1 --splits 'LCPLATE:50;DFIPLATE:10'
