# MEGA Panel A — adding PITC to each well of the plate
# Uses P100
# Lock in the tipbox config for this protocol
disable_tipbox tipbox_p100_c
enable_tipbox tipbox_p100
enable_tipbox tipbox_p100_b

load_pipette TysonP100.json
home all

pipette 50 --tip_end keep PITC1 96wellplatePITC --prewet 5
