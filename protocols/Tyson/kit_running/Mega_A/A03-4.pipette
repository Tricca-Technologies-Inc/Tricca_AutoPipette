# Mega Panel A FS1 and FS2 
load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.


pipette 10.0  --tip_end keep --dest_row 4 --dest_col 0 FS1 96wellplate --prewet 5
pipette 10.0  --tip_end keep --dest_row 5 --dest_col 0 FS1 96wellplate
pipette 10.0  --tip_end keep --dest_row 6 --dest_col 0 FS1 96wellplate
pipette 10.0  --tip_end keep --dest_row 7 --dest_col 0 FS1 96wellplate
pipette 10.0  --tip_end keep --dest_row 0 --dest_col 1 FS1 96wellplate
pipette 10.0  --tip_end keep --dest_row 1 --dest_col 1 FS1 96wellplate
pipette 10.0  --tip_end keep --dest_row 2 --dest_col 1 FS1 96wellplate
pipette 10.0  --tip_end keep --dest_row 3 --dest_col 1 FS1 96wellplate
pipette 10.0  --tip_end keep --dest_row 4 --dest_col 1 FS1 96wellplate
pipette 10.0  --dest_row 5 --dest_col 1 FS1 96wellplate


pipette 10.0  --tip_end keep --dest_row 4 --dest_col 0 FS2 96wellplate  --prewet 5
pipette 10.0  --tip_end keep --dest_row 5 --dest_col 0 FS2 96wellplate 
pipette 10.0  --tip_end keep --dest_row 6 --dest_col 0 FS2 96wellplate 
pipette 10.0  --tip_end keep --dest_row 7 --dest_col 0 FS2 96wellplate 
pipette 10.0  --tip_end keep --dest_row 0 --dest_col 1 FS2 96wellplate 
pipette 10.0  --tip_end keep --dest_row 1 --dest_col 1 FS2 96wellplate 
pipette 10.0  --tip_end keep --dest_row 2 --dest_col 1 FS2 96wellplate 
pipette 10.0  --tip_end keep --dest_row 3 --dest_col 1 FS2 96wellplate 
pipette 10.0  --tip_end keep --dest_row 4 --dest_col 1 FS2 96wellplate 
pipette 10.0  --dest_row 5 --dest_col 1 FS2 96wellplate 
