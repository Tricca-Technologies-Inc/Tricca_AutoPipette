#Mega Panel A steps 6-8, adding LIS to each well and then adding the PBS, CAls, QC and samples to the wells from a PCR plate by column!
#
select_setup Tyson100_system.json
init
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.

pipette 10.0 --tip_end keep --dest_row 1 --dest_col 0 LIS 96wellplate --tipbox tipbox --prewet 5
pipette 10.0 --tip_end keep --dest_row 2 --dest_col 0 LIS 96wellplate --tipbox tipbox
