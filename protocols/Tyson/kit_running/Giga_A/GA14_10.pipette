# Giga A: adding 10uL to each well of the DFI plate for Fia for Mega Panel A. No tip prewetting... 
#
# Lock in the tipbox config for this protocol
disable_tipbox tipbox_p100_c
enable_tipbox tipbox_p100
enable_tipbox tipbox_p100_b

load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.


pipette 10.0 --src_row 0 --src_col 0 COLPLATE DFIPLATE --prewet 1 

pipette 10.0 --src_row 0 --src_col 1 COLPLATE DFIPLATE --prewet 1 

pipette 10.0 --src_row 0 --src_col 2 COLPLATE DFIPLATE --prewet 1 

