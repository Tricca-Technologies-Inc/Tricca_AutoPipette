#Giga B: Adds 20uL of WIS to each well of the LC-MS/MS plate except the first.

load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.

pipette 20.0 --tip_end keep --dest_row 1 --dest_col 0 --src_row 0 --src_col0 manu3 COLPLATE --prewet 5
pipette 20.0 --tip_end keep --dest_row 2 --dest_col 0 --src_row 0 --src_col0 manu3 COLPLATE
pipette 20.0 --tip_end keep --dest_row 3 --dest_col 0 --src_row 0 --src_col0 manu3 COLPLATE
