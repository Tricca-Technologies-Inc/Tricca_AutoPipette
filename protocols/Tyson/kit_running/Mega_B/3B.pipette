#Adds 10uL of L-RA to each well of the LC-MS/MS plate except the first.

load_pipette TysonP100.json
home
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.

pipette 10.0 --tip_end keep --dest_row 1 --dest_col 0 LRA COLPLATE --prewet 5
pipette 10.0 --tip_end keep --dest_row 2 --dest_col 0 LRA COLPLATE
