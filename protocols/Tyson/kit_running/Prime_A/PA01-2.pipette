# Prime Panel A: Adding 10 μL of LC ISTD and FIA ISTD to each wells of the plate except the double blank well position

load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.

pipette 10.0 --tip_end keep --dest_row 1 --dest_col 0 FIS1 96wellplate --prewet 5
pipette 10.0 --tip_end keep --dest_row 2 --dest_col 0 FIS1 96wellplate
