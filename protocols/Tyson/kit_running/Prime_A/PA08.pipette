#Prime Panel A step 8, adding the PBS, CAls, QC and samples to the wells from a PCR plate by column!
#
load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.


# now with inverted pcr plate (by column not row) might want to add a liquid serum category to remove after air effect. 

pipette 10.0 --tip_end keep --src_row 1 --src_col 0 --dest_row 1 --dest_col 0 96wellplatePCR2 96wellplateSAMPLE --prewet 5
pipette 10.0 --tip_end keep --src_row 2 --src_col 0 --dest_row 2 --dest_col 0 96wellplatePCR2 96wellplateSAMPLE
pipette 10.0 --src_row 3 --src_col 0 --dest_row 3 --dest_col 0 96wellplatePCR2 96wellplateSAMPLE

pipette 10.0 --src_row 4 --src_col 0 --dest_row 4 --dest_col 0 96wellplatePCR2 96wellplateSAMPLE --prewet 1
