# A combined protocol for making prime panel B CAL7-1 10mL

load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.

# beta-Hydroxybutyric acid
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 0 --src_col 0 manu4 KIT1 --prewet 1 

# alpha-Ketoglutaric acid
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 

# Citric acid
pipette 50.0 --src_row 2 --src_col 0 manu4 KIT1 --prewet 1 --tip_end keep
pipette 50.0 --src_row 2 --src_col 0 manu4 KIT1 --prewet 1 

# Butyric acid
pipette 80.0 --src_row 3 --src_col 0 manu4 KIT1 80.0 --prewet 1 

# Propionic acid
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 

# HPHPA
pipette 80.0 --src_row 1 --src_col 0 manu3 KIT1 --prewet 1 

# para-hydroxyhippuric acid
pipette 80.0 --src_row 2 --src_col 0 manu3 KIT1 --prewet 1 

# Succinic acid
pipette 80.0 --src_row 3 --src_col 0 manu3 KIT1 --prewet 1 

# Fumaric acid
pipette 40.0 --src_row 0 --src_col 1 manu4 KIT1 --prewet 1 

# Pyruvic acid
pipette 50.0 --tip_end keep --src_row 1 --src_col 1 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 1 manu4 KIT1 --prewet 1 

# Isobutyric acid
pipette 80.0 --src_row 2 --src_col 1 manu4 KIT1 --prewet 1 

# Hippuric acid
pipette 40.0 --src_row 3 --src_col 1 manu4 KIT1 --prewet 1 

# Methylmalonic acid
pipette 40.0 --src_row 0 --src_col 1 manu3 KIT1 --prewet 1 

# Homovanillic acid
pipette 8.0 --src_row 1 --src_col 1 manu3 KIT1 --prewet 1 

# Indole acetic acid
pipette 80.0 --src_row 2 --src_col 1 manu3 KIT1 --prewet 1 

load_pipette TysonP1000.json
home all
#
# This protocol uses the Tyson1000 liquid profile's air gaps

# Lactic acid
pipette 500.0 --tip_end keep --src_row 0 --src_col 0 MANU1_p1000 KIT1_p1000 --prewet 1
pipette 500.0 --src_row 0 --src_col 0 MANU1_p1000 KIT1_p1000 --prewet 1

pipette 441.0 --tip_end keep WATER KIT1_p1000 --prewet 5
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 --tip_end keep WATER KIT1_p1000
pipette 441.0 WATER KIT1_p1000
