# A protocol for making prime panel B CAL7-1 5mL, for the components requiring the smaller pipette tips, modified with 5x diluted homovanillic acid

load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.

# beta-Hydroxybutyric acid
pipette 50.0 --src_row 0 --src_col 0 manu4 KIT1 --prewet 1 

# alpha-Ketoglutaric acid
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 

# Citric acid
pipette 50.0 --src_row 2 --src_col 0 manu4 KIT1 --prewet 1 

# Butyric acid
pipette 40.0 --src_row 3 --src_col 0 manu4 KIT1 --prewet 1 

# Propionic acid
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 
pipette 50.0 --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 

# HPHPA
pipette 40.0 --src_row 1 --src_col 0 manu3 KIT1 --prewet 1 

# para-hydroxyhippuric acid
pipette 40.0 --src_row 2 --src_col 0 manu3 KIT1 --prewet 1 

# Succinic acid
pipette 40.0 --src_row 3 --src_col 0 manu3 KIT1 --prewet 1 

# Fumaric acid
pipette 20.0 --src_row 0 --src_col 1 manu4 KIT1 --prewet 1 

# Pyruvic acid
pipette 50.0 --src_row 1 --src_col 1 manu4 KIT1 --prewet 1 

# Isobutyric acid
pipette 40.0 --src_row 2 --src_col 1 manu4 KIT1 --prewet 1 

# Hippuric acid
pipette 20.0 --src_row 3 --src_col 1 manu4 KIT1 --prewet 1 

# Methylmalonic acid
pipette 20.0 --src_row 0 --src_col 1 manu3 KIT1 --prewet 1 

# Homovanillic acid
pipette 20.0 --src_row 1 --src_col 1 manu3 KIT1 --prewet 1 

# Indole acetic acid
pipette 40.0 --src_row 2 --src_col 1 manu3 KIT1 --prewet 1 
