# A protocol for making prime panel A 10mL, all steps combined.
#
load_pipette TysonP100.json
home all
#
# This protocol uses the Tyson100 liquid profile's air gaps explicitly:
# pre-air 30 µL, post-air 5 µL. Each prewet cycle uses the transfer volume.

# Acetylornithine
pipette 50.0 --src_row 0 --src_col 0 manu2 KIT1 --prewet 1 

# Asymmetric dimethylarginine
pipette 50.0 --src_row 1 --src_col 0 manu2 KIT1 --prewet 1 

# Carnosine
pipette 50.0 --src_row 2 --src_col 0 manu2 KIT1 --prewet 1 

# Creatinine
pipette 50.0 --src_row 3 --src_col 0 manu2 KIT1 --prewet 1 

# Dopa
pipette 50.0 --src_row 0 --src_col 0 manu1 KIT1 --prewet 1 

# Dopamine
pipette 50.0 --src_row 1 --src_col 0 manu1 KIT1 --prewet 1 

# Histamine
pipette 50.0 --src_row 2 --src_col 0 manu1 KIT1 --prewet 1 

# Methioninesulfoxide
pipette 50.0 --src_row 3 --src_col 0 manu1 KIT1 --prewet 1 

# Hydroxyproline (t4-OH-Pro)
pipette 50.0 --src_row 0 --src_col 1 manu2 KIT1 --prewet 1 

# Hydroxyproline (c4-OH-Pro)
pipette 50.0 --src_row 1 --src_col 1 manu2 KIT1 --prewet 1 

# Phenylethylamine
pipette 50.0 --src_row 2 --src_col 1 manu2 KIT1 --prewet 1 

# Putrescine
pipette 50.0 --src_row 3 --src_col 1 manu2 KIT1 --prewet 1 

# Sarcosine
pipette 50.0 --src_row 0 --src_col 1 manu1 KIT1 --prewet 1 

# Serotonin
pipette 50.0 --src_row 1 --src_col 1 manu1 KIT1 --prewet 1 

# Spermidine
pipette 50.0 --src_row 2 --src_col 1 manu1 KIT1 --prewet 1 

# Spermine
pipette 50.0 --src_row 3 --src_col 1 manu1 KIT1 --prewet 1 

# Diacetylspermine
pipette 25.0 --src_row 0 --src_col 2 manu2 KIT1 --dispense_vol 25.0 --prewet 1 

# Taurine
pipette 50.0 --src_row 1 --src_col 2 manu2 KIT1 --prewet 1 

# Tyramine
pipette 50.0 --src_row 2 --src_col 2 manu2 KIT1 --prewet 1 

# Alanine
pipette 50.0 --tip_end keep --src_row 3 --src_col 2 manu2 KIT1 --prewet 1 
pipette 50.0 --src_row 3 --src_col 2 manu2 KIT1 --prewet 1 

# Arginine
pipette 50.0 --src_row 0 --src_col 2 manu1 KIT1 --prewet 1 

# Asparagine
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 2 manu1 KIT1 --prewet 1 

# Aspartate
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 
pipette 50.0 --src_row 2 --src_col 2 manu1 KIT1 --prewet 1 

# Citrulline
pipette 50.0 --src_row 3 --src_col 2 manu1 KIT1 --prewet 1 

# Glutamate
pipette 50.0 --tip_end keep --src_row 0 --src_col 3 manu2 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 3 manu2 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 3 manu2 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 3 manu2 KIT1 --prewet 1 
pipette 50.0 --src_row 0 --src_col 3 manu2 KIT1 --prewet 1 

# Glutamine
pipette 50.0 --tip_end keep --src_row 1 --src_col 3 manu2 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 3 manu2 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 3 manu2 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 3 manu2 KIT1 --prewet 1 

# Glycine
pipette 50.0 --src_row 2 --src_col 3 manu2 KIT1 --prewet 1 

# Histidine
pipette 50.0 --src_row 3 --src_col 3 manu2 KIT1 --prewet 1 

# Isoleucine
pipette 50.0 --src_row 0 --src_col 0 manu4 KIT1 --prewet 1 

# Leucine
pipette 50.0 --src_row 1 --src_col 0 manu4 KIT1 --prewet 1 

# Lysine
pipette 50.0 --src_row 2 --src_col 0 manu4 KIT1 --prewet 1 

# Methionine
pipette 50.0 --src_row 3 --src_col 0 manu4 KIT1 --prewet 1 

# Ornithine
pipette 50.0 --src_row 0 --src_col 0 manu3 KIT1 --prewet 1 

# Phenylalanine
pipette 50.0 --src_row 1 --src_col 0 manu3 KIT1 --prewet 1 

# Proline
pipette 50.0 --src_row 2 --src_col 0 manu3 KIT1 --prewet 1 

# Serine
pipette 50.0 --src_row 3 --src_col 0 manu3 KIT1 --prewet 1 

# Threonine
pipette 50.0 --src_row 0 --src_col 1 manu4 KIT1 --prewet 1 

# Tryptophan
pipette 50.0 --tip_end keep --src_row 1 --src_col 1 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 1 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 1 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 1 manu4 KIT1 --prewet 1 

# Valine
pipette 50.0 --src_row 2 --src_col 1 manu4 KIT1 --prewet 1 

# Methylhistidine
pipette 50.0 --src_row 3 --src_col 1 manu4 KIT1 --prewet 1 

# Homocysteine
pipette 50.0 --tip_end keep --src_row 0 --src_col 1 manu3 KIT1 --prewet 1 
pipette 50.0 --src_row 0 --src_col 1 manu3 KIT1 --prewet 1 

# Betaine
pipette 50.0 --src_row 1 --src_col 1 manu3 KIT1 --prewet 1 

# TMAO
pipette 50.0 --tip_end keep --src_row 2 --src_col 1 manu3 KIT1 --prewet 1 
pipette 50.0 --src_row 2 --src_col 1 manu3 KIT1 --prewet 1 

# Choline
pipette 25.0 --src_row 3 --src_col 1 manu3 KIT1 --dispense_vol 25.0 --prewet 1 

# Nitrotyrosine
pipette 60.0 --tip_end keep --src_row 0 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 0 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 0 --src_col 2 manu4 KIT1 --prewet 1 

# Tyrosine
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 2 manu4 KIT1 --prewet 1 

# Kynurenine
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 
pipette 50.0 --src_row 2 --src_col 2 manu4 KIT1 --prewet 1 

# Creatine
pipette 50.0 --src_row 3 --src_col 2 manu4 KIT1 --prewet 1 

# Phosphocreatine
pipette 50.0 --src_row 0 --src_col 2 manu3 KIT1 --prewet 1 

# alpha-Aminoadipic acid
pipette 60.0 --tip_end keep --src_row 1 --src_col 2 manu3 KIT1 --prewet 1 
pipette 50.0 --tip_end keep --src_row 1 --src_col 2 manu3 KIT1 --prewet 1 
pipette 50.0 --src_row 1 --src_col 2 manu3 KIT1 --prewet 1 

#adding the larger volumes for the 10mL prime panel A CAL 7-1kit making procedure

load_pipette TysonP1000.json
home all

pipette 465.2 --tip_end keep WATER KIT1_p1000 --prewet 5
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 --tip_end keep WATER KIT1_p1000 
pipette 465.2 WATER KIT1_p1000 
