# A protocol for making prime panel B CAL7-1 10mL, for the componentsrequiring the smaller pipette tips

# beta-Hydroxybutyric acid
pipette 50.0 --keep_tip --extra_air --after_air --src_row 0 --src_col 0 manu2 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 
pipette 50.0 --extra_air --after_air --src_row 0 --src_col 0 manu2 KIT1 --dispense_vol 50.0 --tipbox tipbox --prewet 1 

