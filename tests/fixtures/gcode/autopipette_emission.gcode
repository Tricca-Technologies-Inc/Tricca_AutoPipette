G90
M220 S100
SET_VELOCITY_LIMIT VELOCITY=99999.0
SET_VELOCITY_LIMIT ACCEL=40000.0
; Homing all axes (X, Y, Z)
G28
; Homing pipette motors (servo + stepper)
; Homing servo (retract to home position)
SET_SERVO SERVO=pipette_servo ANGLE=100
G4 P850
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0 MOVE=120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=home
MANUAL_STEPPER STEPPER=pipette_stepper MOVE=-120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=inverted_home
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0
; Pipette initialized: absolute coordinates, speed configured, XYZ and pipette motors homed
G91
M220 S150
SET_VELOCITY_LIMIT VELOCITY=5000
SET_VELOCITY_LIMIT ACCEL=3000
; Homing X axis
G28 X
; Homing Y axis
G28 Y
; Homing Z axis
G28 Z
G1 Z3.0 F12000.0
; Displaying message: hello world
M117 hello world
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0 MOVE=-1.125 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=try_home
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0 MOVE=120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=home
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0
; Transferring 20μL from 'plate_a' to 'plate_a' (1 chunk(s))
; Aspirating 20μL from 'plate_a' (pre_air_gap=0μL[explicit flag], post_air_gap=0μL[explicit flag], prewet=0x10μL[explicit flag/explicit flag])
G1 X100.0 Y100.0 F38000.0
G1 Z5.0 F12000.0
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0 MOVE=120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=home
MANUAL_STEPPER STEPPER=pipette_stepper MOVE=-120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=inverted_home
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0
G1 Z5.0 F12000.0
G4 P100
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0 MOVE=-15.253166683350248 SPEED=25.0 ACCEL=200.0 STOP_ON_ENDSTOP=try_home
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0
G4 P200
G1 Z5.0 F12000.0
G4 P100
; Dispensing remaining volume to 'plate_a'
G1 X91.0 Y100.0 F38000.0
G1 Z5.0 F12000.0
G1 Z5.0 F12000.0
G4 P100
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0 MOVE=120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=home
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0
G4 P200
G1 Z5.0 F12000.0
G4 P100
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0 MOVE=120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=home
MANUAL_STEPPER STEPPER=pipette_stepper MOVE=-120.0 SPEED=50.0 ACCEL=200.0 STOP_ON_ENDSTOP=inverted_home
MANUAL_STEPPER STEPPER=pipette_stepper SET_POSITION=0
; Disposing tip to waste container
G1 X50.0 Y50.0 F38000.0
G1 Z5.0 F12000.0
G1 Z5.0 F12000.0
G4 P100
; Ejecting tip
SET_SERVO SERVO=pipette_servo ANGLE=100
SET_SERVO SERVO=pipette_servo ANGLE=130
G4 P850
SET_SERVO SERVO=pipette_servo ANGLE=100
G4 P850
G1 Z5.0 F12000.0
G4 P100
