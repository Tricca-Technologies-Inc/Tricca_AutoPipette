# BTT Octopus V1.1 (non-Pro), STM32F446: 32KiB bootloader, 12 MHz crystal,
# USB on PA11/PA12 (Klipper config/generic-bigtreetech-octopus-v1.1.cfg).
# An Octopus V1.1 with an STM32F429 needs an 8 MHz crystal instead: check the
# chip marking (Phase 0) before using this file.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F446=y
CONFIG_STM32_FLASH_START_8000=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_12M=y
CONFIG_STM32_USB_PA11_PA12=y
